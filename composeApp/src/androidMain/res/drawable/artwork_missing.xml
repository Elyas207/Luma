<!--
  Shown wherever cover art is absent or fails to load.

  What it replaces was a crossed-out picture frame, which is the icon for "something went wrong".
  Missing artwork is not an error: local files often have none, uploads get deleted, and a cold
  start with no network hits it on every row at once. A wall of error icons makes a working app
  look broken.

  So: a soft filled tile with a quiet note in it. Neutral grey at low alpha rather than a palette
  colour, because this is drawn by Coil outside any Compose theme and has to sit correctly on all
  ten skins, light and dark alike.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">

    <path
        android:fillColor="#26808080"
        android:pathData="M0,0 L24,0 L24,24 L0,24 Z" />

    <path
        android:fillColor="#59808080"
        android:pathData="M12.6,5.2 h1.6 v10.4 h-1.6 z" />

    <path
        android:fillColor="#59808080"
        android:pathData="M14.2,5.2 c2.0,0.6 3.5,1.8 4.0,3.5 c0.2,-2.3 -1.5,-4.1 -4.0,-4.7 z" />

    <path
        android:fillColor="#59808080"
        android:pathData="M12.6,15.6 m-3.0,0 a3.0,2.5 0 1,0 6.0,0 a3.0,2.5 0 1,0 -6.0,0 z" />
</vector>
